  "role": "primary",
  "deployment": "saas",
  "wire": "anthropic_messages",
  "endpoint_env": "ANTHROPIC_BASE_URL",
  "credential_ref": "vault://llm/anthropic/api-key",
  "context_tokens": 200000,
  "max_output_tokens": 64000,
  "capabilities": {
