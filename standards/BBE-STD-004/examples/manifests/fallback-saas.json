{
  "manifest_version": "1",
  "id": "openai/gpt-5",
  "vendor": "openai",
  "model": "gpt-5",
  "role": "fallback",
  "deployment": "saas",
  "wire": "openai_chat",
  "endpoint_env": "OPENAI_BASE_URL",
  "credential_ref": "vault://llm/openai/api-key",
  "context_tokens": 200000,
  "max_output_tokens": 32000,
  "capabilities": {
    "tools": true,
    "json_mode": true,
    "streaming": true,
    "system_prompt": true,
    "vision": true,
    "prompt_cache": true
  },
  "sovereignty": {
    "data_region": "us",
    "weights_portable": false,
    "runs_offline": false
  },
  "cost_per_mtok": { "input": 3.0, "output": 15.0, "currency": "USD" },
  "notes": "EXAMPLE. A second SaaS vendor removes single-vendor risk but not jurisdiction risk — both sovereignty.data_region values are 'us'."
}
