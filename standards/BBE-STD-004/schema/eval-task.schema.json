{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.bbe-dbe.internal/BBE-STD-004/eval-task.schema.json",
  "title": "BBE-STD-004 Golden Corpus Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_version", "id", "category", "weight", "prompt", "checks"],
  "properties": {
    "task_version": { "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "category": { "type": "string", "minLength": 1 },
    "weight": { "type": "integer", "minimum": 1, "maximum": 10 },
    "requires": {
      "type": "array",
      "items": { "enum": ["tools", "json_mode", "streaming", "system_prompt", "vision", "prompt_cache"] },
      "description": "Manifest capability flags this task depends on. Missing flag => task is 'blocked', not 'failed'."
    },
    "min_context_tokens": { "type": "integer", "minimum": 1 },
    "system": { "type": "string" },
    "prompt": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["contains_all", "contains_any", "not_contains", "regex", "json_has_keys", "equals_normalized"] },
          "values": { "type": "array", "items": { "type": "string" } },
          "keys": { "type": "array", "items": { "type": "string" } },
          "pattern": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
